# RepoRadar configuration. Copy to .env and keep it PRIVATE (chmod 600).
# Everything here is OPTIONAL. Public GitHub data works without any token.
# Never commit .env. Never paste a token into a chat, issue, or screenshot.

# --- GitHub (optional, recommended for stable daily runs) ---
# A fine-grained PAT with NO scopes is enough for public repositories.
# Raises the search limit from 10/min to 30/min and core from 60/h to 5000/h.
GITHUB_TOKEN=

# --- Discovery tuning (optional) ---
# Comma-separated. One topic and one language rotate into the query plan daily.
REPORADAR_LANGUAGES=Python,TypeScript,Rust,Go,JavaScript
REPORADAR_TOPICS=ai,llm,developer-tools,mcp,rust,automation
REPORADAR_NEW_WINDOW_DAYS=7
REPORADAR_HIDDEN_WINDOW_DAYS=30
REPORADAR_MIN_STARS=5
REPORADAR_HIDDEN_MAX_STARS=400
REPORADAR_ITEMS_PER_SECTION=8
REPORADAR_SUPPRESS_DAYS=7
REPORADAR_TIMEZONE=Asia/Kolkata

# 0 = automatic budget (6 queries anonymous / 10 with a token).
REPORADAR_MAX_SEARCH_QUERIES=0
REPORADAR_ENABLE_TRENDING=1
REPORADAR_ENABLE_DEVELOPERS=1
REPORADAR_ENABLE_USER_SEARCH=1

# --- Delivery (all optional; NOTHING is sent by default) ---
# Telegram: create a bot with @BotFather, add it to your channel as admin,
# then use @channelusername or the numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# Custom webhook host is blocked unless you explicitly opt in below.
CUSTOM_WEBHOOK_URL=
REPORADAR_ALLOW_CUSTOM_WEBHOOK_HOST=0

# Automation safety: auto_notify alone is NOT enough; dry_run must also be 0.
REPORADAR_AUTO_NOTIFY=0
REPORADAR_DRY_RUN=1

# --- Advanced (leave alone unless you know why) ---
# REPORADAR_HOME=/path/to/reporadar
# REPORADAR_DATA_DIR=/path/to/private/data
# REPORADAR_SITE_DIR=/path/to/site
# REPORADAR_RESOLVE_DNS=1
# REPORADAR_TIMEOUT=15
